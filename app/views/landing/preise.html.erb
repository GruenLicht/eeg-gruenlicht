<% stand = eeg_preise %>
<% content_for :title, "Strompreise" %>
<% content_for :meta_description, "Aktuelle, künftige und bisherige Bezugs- und Einspeisepreise der EEG-GrünLicht-Energiegemeinschaften — derzeit #{energiepreis_kurz(stand)}, direkt aus der Abrechnung der EEG." %>
<% content_for :canonical_path, preise_path %>

<section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
        <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-green-700">
                Preisübersicht
            </p>

            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
                Aktuelle und bisherige Strompreise
            </h1>

            <p class="mt-5 text-lg leading-8 text-slate-600">
                Die drei Energiegemeinschaften werden als rechtlich und organisatorisch
                eigenständige Vereine geführt. Die Preisgestaltung wird daher von jeder EEG
                selbst beschlossen. Wir bemühen uns jedoch, die Konditionen in allen drei Energiegemeinschaften möglichst einheitlich zu gestalten.
            </p>

            <p class="mt-4 text-sm leading-7 text-slate-500">
                Die Preise auf dieser Seite kommen direkt aus der Abrechnung der EEG — mit genau diesen Preisen
                werden die Rechnungen erstellt.
                <% if stand.erzeugt_am %>
                    Stand: <%= preis_stand(stand.erzeugt_am) %>.
                <% end %>
            </p>
        </div>

        <div class="mt-12 space-y-10">
            <% stand.gemeinschaften.each do |eeg| %>
                <% aktuell = eeg.aktuell %>
                <section
                    id="preise-<%= eeg.anker %>"
                    class="scroll-mt-28 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm"
                >
                    <div class="border-b border-slate-200 bg-slate-50 px-6 py-5 sm:px-8">
                        <p class="text-sm font-medium text-green-700">
                            Eigenständige Energiegemeinschaft<% if eeg.rc_number.present? %> · <%= eeg.rc_number %><% end %>
                        </p>

                        <h2 class="mt-1 text-xl font-semibold text-slate-900">
                            <%= eeg.name %>
                        </h2>
                    </div>

                    <div class="px-6 py-6 sm:px-8">
                        <% if aktuell %>
                            <p class="text-sm text-slate-500">
                                Aktueller Preis, gültig <%= preis_zeitraum(aktuell) %>
                            </p>

                            <div class="mt-3 grid gap-4 sm:grid-cols-2">
                                <div class="rounded-2xl border border-green-200 bg-green-50 px-5 py-4">
                                    <p class="text-sm text-slate-600">Bezugspreis</p>
                                    <p class="mt-1 text-2xl font-semibold text-slate-900">
                                        <%= ct_kwh(aktuell.bezug) %>
                                        <span class="ml-1 text-sm font-normal text-slate-500"><%= ust_kurz(eeg) %></span>
                                    </p>
                                </div>

                                <div class="rounded-2xl border border-green-200 bg-green-50 px-5 py-4">
                                    <p class="text-sm text-slate-600">Einspeisepreis</p>
                                    <p class="mt-1 text-2xl font-semibold text-slate-900">
                                        <%= ct_kwh(aktuell.einspeisung) %>
                                        <span class="ml-1 text-sm font-normal text-slate-500"><%= PreiseHelper::EINSPEISUNG_UST %></span>
                                    </p>
                                </div>
                            </div>
                        <% end %>
                    </div>

                    <div class="overflow-x-auto border-t border-slate-200">
                        <table class="w-full min-w-[640px] text-left">
                            <thead class="border-b border-slate-200 bg-white">
                                <tr>
                                    <th class="px-6 py-4 text-sm font-semibold text-slate-900 sm:px-8">
                                        Gültigkeitszeitraum
                                    </th>

                                    <th class="px-6 py-4 text-sm font-semibold text-slate-900">
                                        Bezugspreis
                                    </th>

                                    <th class="px-6 py-4 text-sm font-semibold text-slate-900">
                                        Einspeisepreis
                                    </th>

                                    <th class="px-6 py-4 text-sm font-semibold text-slate-900 sm:pr-8">
                                        Status
                                    </th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-200">
                                <% zeilen = eeg.kuenftig.reverse.map { |z| [ z, :kuenftig ] } %>
                                <% zeilen << [ aktuell, :aktuell ] if aktuell %>
                                <% zeilen += eeg.historie.map { |z| [ z, :historisch ] } %>

                                <% zeilen.each do |zeitraum, status| %>
                                    <tr class="<%= status == :aktuell ? "bg-green-50" : "bg-white" %>">
                                        <td class="px-6 py-5 text-sm text-slate-700 sm:px-8">
                                            <%= preis_zeitraum(zeitraum) %>
                                        </td>

                                        <td class="px-6 py-5">
                                            <span class="font-semibold text-slate-900">
                                                <%= ct_kwh(zeitraum.bezug) %>
                                            </span>
                                            <span class="ml-1 text-sm text-slate-500">
                                                <%= ust_kurz(eeg) %>
                                            </span>
                                        </td>

                                        <td class="px-6 py-5">
                                            <span class="font-semibold text-slate-900">
                                                <%= ct_kwh(zeitraum.einspeisung) %>
                                            </span>
                                            <span class="ml-1 text-sm text-slate-500">
                                                <%= PreiseHelper::EINSPEISUNG_UST %>
                                            </span>
                                        </td>

                                        <td class="px-6 py-5 sm:pr-8">
                                            <% case status %>
                                            <% when :aktuell %>
                                                <span class="inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">
                                                    Aktuell
                                                </span>
                                            <% when :kuenftig %>
                                                <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                                                    Beschlossen
                                                </span>
                                            <% else %>
                                                <span class="text-sm text-slate-500">
                                                    Historisch
                                                </span>
                                            <% end %>
                                        </td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    </div>

                    <div class="border-t border-slate-200 px-6 py-5 text-sm leading-7 text-slate-600 sm:px-8">
                        <% if eeg.gebuehren.any? %>
                            <p class="font-medium text-slate-900">Gebühren</p>
                            <ul class="mt-1 list-disc pl-5">
                                <% eeg.gebuehren.each do |gebuehr| %>
                                    <li><%= gebuehr_text(gebuehr) %></li>
                                <% end %>
                            </ul>
                        <% else %>
                            <p>Gebühren: keine — verrechnet wird nur die Energie.</p>
                        <% end %>

                        <p class="mt-3 text-slate-500">
                            Bezugspreis: <%= eeg.ust_hinweis %>.
                            Einspeisepreis: <%= PreiseHelper::EINSPEISUNG_UST %>.
                        </p>
                    </div>
                </section>
            <% end %>
        </div>

        <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 px-6 py-5 text-sm leading-7 text-slate-600">
            <p>
                Die angeführten Preise beziehen sich auf die innerhalb der jeweiligen EEG
                eingespeiste beziehungsweise bezogene Energie. Beim Strombezug aus der EEG gilt zusätzlich ein
                ermäßigter Netz-Arbeitspreis; den übrigen Strom liefert wie bisher Ihr Stromlieferant zu seinem Preis.
                Was eine kWh aus der Energiegemeinschaft insgesamt kostet, erklären wir in den
                <%= link_to "häufigen Fragen", "/#faq-gesamtkosten", class: "font-medium text-green-700 underline decoration-green-300 underline-offset-2 hover:text-green-800" %>.<br>
                Änderungen der Preise werden von der jeweils zuständigen Energiegemeinschaft
                beschlossen und vor ihrem Inkrafttreten bekannt gegeben.
            </p>
        </div>
    </div>
</section>
